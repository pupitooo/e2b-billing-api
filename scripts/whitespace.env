# Shared whitespace policy for local commands, staged checks, and CI.
# Tool versions and compatible analysis dependencies: scripts/whitespace/go.mod.
# Keep declarations and their initialization together; avoid syntax-only grouping.
WSL_CHECKS=after-block,return,branch,err,leading-whitespace,trailing-whitespace
# Short guard bodies stay compact; longer blocks separate their final branch.
WSL_BRANCH_MAX_LINES=2
