#!/bin/sh
set -eu

# Check exactly what Git will commit, including temporary indexes used by -a.
# Exporting the index preserves partial staging and excludes unstaged files.
cd "$(git rev-parse --show-toplevel)"
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/e2b-pre-commit.XXXXXX")
trap 'rm -rf "$snapshot"' EXIT
trap 'exit 1' HUP INT TERM
git checkout-index --all --prefix="$snapshot/"
cd "$snapshot"
sh scripts/go-quality.sh check
