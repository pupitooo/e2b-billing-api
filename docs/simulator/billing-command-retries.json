{
  "name": "billing-command-retries",
  "steps": [
    {
      "name": "fresh account",
      "request": {
        "method": "GET",
        "path": "/customers/acme/credit"
      },
      "want": {
        "status": 200,
        "body": {
          "customer_id": "acme",
          "credit_balance_ticks": "0",
          "pending_events": 0,
          "processing_errors": 0,
          "state_version": 0
        }
      }
    },
    {
      "name": "grant once with lost reply",
      "request": {
        "method": "POST",
        "path": "/customers/acme/credits",
        "body": {
          "amount_cents": 2500,
          "recorded_at": "2026-10-01T00:00:00Z",
          "idempotency_key": "welcome"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "amount_cents": 2500,
          "recorded_at": "2026-10-01T00:00:00Z",
          "idempotency_key": "welcome"
        }
      },
      "fault": {
        "lose_response": true
      }
    },
    {
      "name": "unchanged credit grant retry",
      "request": {
        "method": "POST",
        "path": "/customers/acme/credits",
        "body": {
          "amount_cents": 2500,
          "recorded_at": "2026-10-01T00:00:00Z",
          "idempotency_key": "welcome"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "amount_cents": 2500,
          "recorded_at": "2026-10-01T00:00:00Z",
          "idempotency_key": "welcome"
        }
      }
    },
    {
      "name": "changed credit grant conflicts",
      "request": {
        "method": "POST",
        "path": "/customers/acme/credits",
        "body": {
          "amount_cents": 2600,
          "recorded_at": "2026-10-01T00:00:00Z",
          "idempotency_key": "welcome"
        }
      },
      "want": {
        "status": 409,
        "body": {
          "error": {
            "code": "billing_conflict"
          }
        }
      }
    },
    {
      "name": "only one grant reached the balance",
      "request": {
        "method": "GET",
        "path": "/customers/acme/credit"
      },
      "want": {
        "status": 200,
        "body": {
          "customer_id": "acme",
          "credit_balance_ticks": "2500000000",
          "pending_events": 0,
          "processing_errors": 0,
          "state_version": 1
        }
      },
      "await": true
    },
    {
      "name": "purchase once",
      "request": {
        "method": "POST",
        "path": "/customers/acme/addons",
        "body": {
          "idempotency_key": "acme-pack",
          "addon_name": "concurrency_pack",
          "purchased_at": "2026-10-05T00:00:00Z"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "monthly_price_cents": 2000
        }
      },
      "capture": "created-acme-pack"
    },
    {
      "name": "unchanged purchase retry",
      "request": {
        "method": "POST",
        "path": "/customers/acme/addons",
        "body": {
          "idempotency_key": "acme-pack",
          "addon_name": "concurrency_pack",
          "purchased_at": "2026-10-05T00:00:00Z"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "monthly_price_cents": 2000
        }
      }
    },
    {
      "name": "second subscription identity conflicts",
      "request": {
        "method": "POST",
        "path": "/customers/acme/addons",
        "body": {
          "idempotency_key": "another-pack",
          "addon_name": "concurrency_pack",
          "purchased_at": "2026-10-05T00:00:00Z"
        }
      },
      "want": {
        "status": 409,
        "body": {
          "error": {
            "code": "billing_conflict"
          }
        }
      }
    },
    {
      "name": "set first limit",
      "request": {
        "method": "POST",
        "path": "/customers/acme/spend-limit",
        "body": {
          "limit_cents": 1500,
          "idempotency_key": "first-limit"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "limit_cents": 1500,
          "idempotency_key": "first-limit"
        }
      }
    },
    {
      "name": "raise limit",
      "request": {
        "method": "POST",
        "path": "/customers/acme/spend-limit",
        "body": {
          "limit_cents": 2000,
          "idempotency_key": "raised-limit"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "limit_cents": 2000,
          "idempotency_key": "raised-limit"
        }
      }
    },
    {
      "name": "retry old change without reverting the newer limit",
      "request": {
        "method": "POST",
        "path": "/customers/acme/spend-limit",
        "body": {
          "limit_cents": 1500,
          "idempotency_key": "first-limit"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "limit_cents": 1500,
          "idempotency_key": "first-limit"
        }
      }
    },
    {
      "name": "newer limit survived old retry",
      "request": {
        "method": "GET",
        "path": "/customers/acme/months/2026-10/limit-status"
      },
      "want": {
        "status": 200,
        "body": {
          "customer_id": "acme",
          "month": "2026-10",
          "limit_cents": 2000,
          "gross_charge_ticks": "0",
          "limit_reached": false,
          "pending_events": 0,
          "processing_errors": 0
        }
      },
      "await": true
    },
    {
      "name": "append a future default price",
      "request": {
        "method": "POST",
        "path": "/prices",
        "body": {
          "idempotency_key": "new-default",
          "customer_id": null,
          "metric": "cpu_seconds",
          "price_per_million_cents": 7,
          "effective_from": "2026-12-01T00:00:00Z"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "price_per_million_cents": 7
        }
      },
      "capture": "created-new-default"
    },
    {
      "name": "retry the unchanged price version",
      "request": {
        "method": "POST",
        "path": "/prices",
        "body": {
          "idempotency_key": "new-default",
          "customer_id": null,
          "metric": "cpu_seconds",
          "price_per_million_cents": 7,
          "effective_from": "2026-12-01T00:00:00Z"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "price_version_id": "{{capture.created-new-default.price_version_id}}",
          "price_per_million_cents": 7
        }
      }
    },
    {
      "name": "changed price identity conflicts",
      "request": {
        "method": "POST",
        "path": "/prices",
        "body": {
          "idempotency_key": "new-default",
          "customer_id": null,
          "metric": "cpu_seconds",
          "price_per_million_cents": 8,
          "effective_from": "2026-12-01T00:00:00Z"
        }
      },
      "want": {
        "status": 409,
        "body": {
          "error": {
            "code": "billing_conflict"
          }
        }
      }
    },
    {
      "name": "grants and purchases were never duplicated",
      "request": {
        "method": "GET",
        "path": "/customers/acme/credit"
      },
      "want": {
        "status": 200,
        "body": {
          "customer_id": "acme",
          "credit_balance_ticks": "2500000000",
          "pending_events": 0,
          "processing_errors": 0,
          "state_version": 4
        }
      },
      "await": true
    }
  ]
}
