{
  "name": "billing-missed-invoice",
  "steps": [
    {
      "name": "grant fifteen dollars before first accounting",
      "business_time": "2026-10-31T00:00:00Z",
      "request": {
        "method": "POST",
        "path": "/customers/acme/credits",
        "body": {
          "idempotency_key": "catchup-credit",
          "amount_cents": 1500
        }
      },
      "want": {
        "status": 200
      }
    },
    {
      "name": "buy recurring add-on in October",
      "business_time": "2026-10-31T00:00:00Z",
      "request": {
        "method": "POST",
        "path": "/customers/acme/addons",
        "body": {
          "idempotency_key": "catchup-addon",
          "addon_name": "concurrency_pack",
          "purchased_at": "2026-10-01"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "monthly_price_cents": 2000,
          "start_month": "2026-10-01"
        }
      }
    },
    {
      "name": "receive ten October dollars",
      "business_time": "2026-10-31T00:00:00Z",
      "request": {
        "method": "POST",
        "path": "/usage/batches",
        "body": {
          "events": [
            {
              "source": "{{source}}",
              "event_id": "catchup-oct",
              "schema_version": 1,
              "customer_id": "acme",
              "sandbox_id": "catch-up",
              "metric": "cpu_seconds",
              "period_start": "2026-10-10T12:00:00Z",
              "period_end": "2026-10-10T13:00:00Z",
              "units": 250000000
            }
          ]
        }
      },
      "want": {
        "status": 202
      }
    },
    {
      "name": "October accounting leaves five dollars credit",
      "business_time": "2026-10-31T00:00:00Z",
      "request": {
        "method": "GET",
        "path": "/customers/acme/credit"
      },
      "want": {
        "status": 200,
        "body": {
          "credit_balance_microcents": "500000000",
          "pending_events": 0,
          "processing_errors": 0
