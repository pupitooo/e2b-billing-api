{
  "name": "billing-month-boundary",
  "steps": [
    {
      "name": "fresh account",
      "request": {
        "method": "GET",
        "path": "/customers/acme/credit"
      },
      "want": {
        "status": 200,
        "body": {
          "customer_id": "acme",
          "credit_balance_ticks": "0",
          "pending_events": 0,
          "processing_errors": 0,
          "state_version": 0
        }
      }
    },
    {
      "name": "durably accept unsupported crossing interval",
      "request": {
        "method": "POST",
        "path": "/usage/batches",
        "body": {
          "events": [
            {
              "source": "{{source}}",
              "event_id": "crossing",
              "schema_version": 1,
              "customer_id": "acme",
              "sandbox_id": "acme-sandbox",
              "metric": "cpu_seconds",
              "period_start": "2026-10-31T23:30:00Z",
              "period_end": "2026-11-01T00:30:00Z",
              "units": 100
            }
          ]
        }
      },
      "want": {
        "status": 202,
        "body": {
          "status": "accepted"
        }
      }
    },
    {
      "name": "quarantine keeps the balance and all financial effects unchanged",
      "request": {
        "method": "GET",
        "path": "/customers/acme/credit"
      },
      "want": {
        "status": 200,
        "body": {
          "customer_id": "acme",
          "credit_balance_ticks": "0",
          "pending_events": 0,
          "processing_errors": 1,
          "state_version": 0
        }
      },
      "await": true
    },
    {
      "name": "quarantined usage does not block invoice issuance",
      "request": {
        "method": "POST",
        "path": "/customers/acme/invoices",
        "body": {
          "month": "2026-10"
        }
      },
      "want": {
        "status": 200,
        "body": {
          "number": "ACME-0001",
          "total_cents": 0,
          "gross_usage_ticks": "0",
          "credit_used_ticks": "0",
          "lines": [
            {
              "kind": "credit",
              "amount_cents": 0
            }
          ]
        }
      }
    },
    {
      "name": "issued invoice remains readable despite quarantined usage",
      "request": {
        "method": "GET",
        "path": "/customers/acme/invoices/2026-10"
      },
      "want": {
        "status": 200,
        "body": {
          "number": "ACME-0001",
          "total_cents": 0
        }
      }
    }
  ]
}
