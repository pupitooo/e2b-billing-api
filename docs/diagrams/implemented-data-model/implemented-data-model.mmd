erDiagram
    direction LR

    customers ||--o| customer_billing_state : customer_id
    customers |o..o{ price_versions : customer_id
    metrics ||..o{ price_versions : metric
    customers ||..o{ rated_usage_groups : customer_id
    price_versions ||..o{ rated_usage_groups : "(price_version_id, metric)"
    usage_inbox ||--o| usage_ratings : "(source, event_id)"
    rated_usage_groups ||..o{ usage_ratings : group_id
    customers ||--o{ monthly_usage : customer_id
    customers ||..o{ credit_entries : customer_id
    rated_usage_groups |o..o{ credit_entries : "(group_id, customer_id)"
    customers ||..o{ addon_subscriptions : customer_id
    addons ||..o{ addon_subscriptions : addon_name

    customers ||--o{ spend_limit_operations : customer_id
    customers ||--o{ closed_billing_months : customer_id
    closed_billing_months ||--o| invoices : "(customer_id, billing_month)"
    invoices ||..o{ invoiced_usage_groups : "(customer_id, billing_month)"
    rated_usage_groups ||--o| invoiced_usage_groups : group_id

    usage_inbox {
        text source PK
        text event_id PK
        integer schema_version "Positive"
        text customer_id
        text sandbox_id
        text metric
        timestamptz period_start
        timestamptz period_end
        bigint units "Non-negative"
        timestamptz received_at
        timestamptz processed_at "Nullable"
        text processing_error "Nullable"
    }
    usage_ratings {
        text source PK,FK
        text event_id PK,FK
        text group_id FK
    }
    rated_usage_groups {
        text group_id PK
        text customer_id FK
        text price_version_id FK
        text metric FK "Composite price FK"
        date usage_month "First day of original UTC month"
        date billing_month "First day; not before usage_month"
        numeric total_units "Non-negative integer"
        billing_ticks exact_charge_ticks
        bigint booked_charge_cents "Non-negative"
        billing_ticks allocated_credit_ticks "At most exact gross ticks"
    }
    customers {
        text customer_id PK
        text name
        text country
        text billing_address
    }
    customer_billing_state {
        text customer_id PK,FK
        billing_ticks credit_balance_ticks "Exact non-negative credit"
        bigint spend_limit_cents "Nullable; non-negative"
        bigint state_version "Non-negative; default 0"
        bigint next_invoice_number "Positive; default 1"
    }
    metrics {
        text metric PK
    }
    price_versions {
        text price_version_id PK
        text customer_id FK "Nullable: default price"
        text metric FK
        bigint price_per_million_cents "Non-negative"
        timestamptz effective_from "Finite"
    }
    monthly_usage {
        text customer_id PK,FK
        date usage_month PK "First day of original UTC month"
        billing_ticks gross_charge_ticks "Before credit and add-ons"
    }
    credit_entries {
        text credit_entry_id PK
        text customer_id FK "Also part of group FK"
        text operation_id
        text group_id FK "Nullable: grants"
        billing_signed_ticks amount_ticks "Positive grant or negative debit"
        timestamptz recorded_at "Finite"
    }
    addons {
        text addon_name PK
        bigint monthly_price_cents "Non-negative"
    }
    addon_subscriptions {
        text subscription_id PK
        text customer_id FK
        text addon_name FK
        bigint monthly_price_cents "Purchased price snapshot"
        timestamptz purchased_at "Finite"
        date start_month "First day of UTC purchase month"
    }
    spend_limit_operations {
        text customer_id PK,FK
        text operation_id PK
        bigint limit_cents "Nullable; non-negative"
        timestamptz recorded_at "Finite"
    }
    closed_billing_months {
        text customer_id PK,FK
        date billing_month PK "First day of UTC billing month"
        timestamptz closed_at "Finite"
    }
    invoices {
        text customer_id PK,FK
        date billing_month PK,FK
        text invoice_number "Unique per customer"
        bigint total_cents "Non-negative"
        jsonb snapshot "Object: buyer, lines, issued_at"
    }
    invoiced_usage_groups {
        text group_id PK,FK
        text customer_id FK
        date billing_month FK
    }
    schema_migrations {
        integer version PK "Positive"
        text name
        timestamptz applied_at "Default now()"
    }

    %% This diagram covers all 16 tables after migrate.sql and migrations 001-009.
    %% All columns are NOT NULL unless explicitly labeled Nullable.
    %% PK and FK markers identify membership in primary and foreign keys, including composite keys.
    %% Solid relationships include parent identity in the child's primary key; dashed ones do not.
    %% Edges show declared foreign keys only; usage_inbox has no customer or metric FK.
    %% billing_ticks is numeric constrained to non-negative finite integers; 1 cent = 1_000_000 ticks.
    %% billing_signed_ticks is numeric constrained to signed finite integers for credit history.
    %% price_versions UNIQUE NULLS NOT DISTINCT: (customer_id, metric, effective_from).
    %% price_versions UNIQUE: (price_version_id, metric).
    %% rated_usage_groups UNIQUE: (customer_id, price_version_id, usage_month, billing_month).
    %% rated_usage_groups UNIQUE: (group_id, customer_id).
    %% credit_entries UNIQUE: (customer_id, operation_id).
    %% addon_subscriptions UNIQUE: (customer_id, addon_name).
    %% invoices UNIQUE: (customer_id, invoice_number).
    %% price_versions, usage_ratings, and credit_entries reject updates and deletes through triggers.
    %% Closed months, spend-limit operations, invoices and invoiced groups reject updates and deletes.
    %% Triggers also preserve group identity and validate receipt customer, metric, and UTC month.
    %% A group referenced by invoiced_usage_groups rejects updates and deletes.
    %% InvoiceLine values are stored in invoices.snapshot.lines; there is no invoice_lines table.
    %% No extra FK matches invoiced_usage_groups customer/month to the group's customer/month.
    %% Those ownership checks belong to the closing transaction; edges show only declared FKs.
