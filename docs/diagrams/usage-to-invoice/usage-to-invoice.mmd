%% User-requested conceptual flow, recorded on 9 October 2026.
%% This is an accounting pipeline, not seven services or seven SQL tables.
%% Pure Go rating, exact credit allocation, and rounding helpers are implemented.
%% The database worker integration remains subsequent work.
%% Credit precedes rounding; migration 004 stores credit in exact ticks.
%% InvoiceLine and Invoice are planned immutable snapshots, not existing tables.
flowchart TB
    events["Usage events<br/>Customer used 1,000 CPU seconds<br/>usage_inbox: raw integer units"]
    rating["Rating<br/>Price rule: USD 0.05 / 1,000,000 units<br/>price_versions + usage_ratings"]
    group["RatedUsageGroup<br/>Sum compatible usage + exact gross ticks<br/>rated_usage_groups"]
    credits["Credits (optional)<br/>Deduct eligible usage credit before rounding<br/>Current DB: exact tick ledger and balance"]
    rounding["Rounding<br/>Round cumulative gross and net to cents<br/>Credit line balances their difference"]
    line["InvoiceLine (planned)<br/>Immutable usage, credit, and add-on lines<br/>Proposed invoice_lines table"]
    invoice["Invoice (planned)<br/>Customer, address, number, and cent total<br/>Proposed invoices table"]

    events --> rating
    rating -->|"1,000 units x 5 = 5,000 ticks"| group
    group --> credits
    credits -->|"Preserve fractional-cent credit in ticks"| rounding
    rounding --> line
    line --> invoice

    classDef input fill:#e9f7ee,stroke:#287d4e,color:#173b28;
    classDef accounting fill:#edf0ff,stroke:#56649c,color:#24335c;
    classDef planned fill:#f2f3f5,stroke:#6b7280,color:#253044,stroke-dasharray:5 4;
    class events input;
    class rating,group,credits,rounding accounting;
    class line,invoice planned;
