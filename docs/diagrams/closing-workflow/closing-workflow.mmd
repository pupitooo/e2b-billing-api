---
title: Monthly closing - processed usage only
config:
  layout: elk
  flowchart:
    wrappingWidth: 420
    nodeSpacing: 35
    rankSpacing: 24
    useMaxWidth: false
---
%% Current contract: one transaction; no usage processing or inbox draining.
flowchart TD
    request["Request closing for customer and UTC month"]
    subgraph transaction["One atomic transaction - customer account lock held until completion"]
        subgraph cutoff["A. Lock and validate"]
            lock["BEGIN; lock customer_billing_state<br/>Cutoff: usage processing committed before this lock"]
            exists{"Invoice already exists?"}
            stored["Read the original immutable invoice"]
            validate["Require an ended UTC month<br/>First closing cannot skip existing earlier usage<br/>Later closing requires the previous month closed<br/>Pending usage in the target month does not block issuance"]
        end
        subgraph build["B. Build the invoice from processed groups"]
            groups["Read rated_usage_groups and applicable add-ons<br/>No processing of pending usage_inbox rows"]
            lines["Round each group's gross and net to half-up cents<br/>Displayed credit = rounded gross minus rounded net<br/>Use credit already allocated by the worker"]
            snapshot["Build buyer snapshot, next invoice number and total"]
        end
        subgraph publication["C. Publish together"]
            freeze["Store the closed month and immutable invoice<br/>Freeze included groups; advance number and state version"]
            commit["COMMIT; release the account lock"]
        end
        lock --> exists
        exists -->|"Yes"| stored --> commit
        exists -->|"No"| validate --> groups --> lines --> snapshot --> freeze --> commit
    end
    result["Return the committed invoice"]
    pending["Pending usage stays in usage_inbox<br/>Worker processes it later under the same account lock<br/>Closed or skipped original month routes after the latest closure"]
    failure["On failure: ROLLBACK the complete transaction<br/>No durable closing attempt, invoice or consumed number<br/>Retry the same customer/month; committed retries return the original invoice"]
    request --> lock
    commit --> result
    commit -.->|"Worker resumes after the lock is released"| pending
    validate -.->|"Validation or history conflict"| failure
    freeze -.->|"Storage failure or timeout"| failure
    style cutoff fill:#eff6ff,stroke:#2563eb
    style build fill:#f0fdfa,stroke:#0d9488
    style publication fill:#fffbeb,stroke:#d97706
