%% Simplified current implementation, checked on 10 October 2026.
%% Capture, each receipt, and publication have separate transaction boundaries.
flowchart TD
    request["Request closing for customer and UTC month"]

    subgraph capture["A. Capture transaction - customer account lock"]
        cohort["Validate and capture or resume the fixed receipt cohort<br/>New closure: UTC month must have ended; check closed history<br/>Retry: retain the cohort; existing invoice needs no capture writes"]
        commitA["COMMIT capture and release the account lock"]
    end

    subgraph drain["B. Receipt processing - one transaction per receipt"]
        process["Process all unprocessed cohort receipts<br/>Reuse worker accounting; allocate credit in exact ticks<br/>Any processing error: durable exclusion; continue issuance"]
    end

    subgraph publication["C. Invoice publication - one atomic transaction"]
        begin["BEGIN and lock the customer account"]
        exists{"Does this monthly invoice exist?"}
        stored["Read the existing immutable snapshot<br/>COMMIT without another invoice or number"]
        ready{"Eligible cohort processed and no earlier<br/>unclosed rated groups?"}
        groups["Read rated groups and applicable add-on subscriptions"]
        lines["Build usage and add-on lines<br/>Round each group's gross and net to half-up cents<br/>Credit deduction = rounded gross minus rounded net"]
        snapshot["Build buyer snapshot, next invoice number and total<br/>Do not debit credit again"]
        freeze["Store the closed month and invoice snapshot<br/>Freeze included groups; advance number and state version"]
        commit["COMMIT all publication writes together"]
    end

    result["Return the committed immutable invoice"]
    blocked["Return validation or conflict error<br/>Resolve the blocker before retrying the same customer/month"]
    retry["On failure: roll back uncommitted work<br/>Retain prior committed capture and receipt processing<br/>Retry the same customer/month to resume or read the invoice"]

    request --> cohort --> commitA --> process --> begin --> exists
    exists -->|"Yes"| stored --> result
    exists -->|"No"| ready
    ready -->|"Yes"| groups --> lines --> snapshot --> freeze --> commit --> result
    ready -->|"No: roll back"| blocked
    cohort -.->|"Rejected: roll back capture"| blocked
    process -.->|"Receipt quarantined"| excluded["Keep usage unprocessed; record immutable cohort exclusion<br/>Repair via controlled SQL; recovered usage bills in an open month"]
    excluded --> begin
    commitA -.->|"Capture failure"| retry
    process -.->|"Storage failure or timeout"| retry
    commit -.->|"Publication failure"| retry

    style capture fill:#eff6ff,stroke:#2563eb
    style drain fill:#f0fdfa,stroke:#0d9488
    style publication fill:#fffbeb,stroke:#d97706
