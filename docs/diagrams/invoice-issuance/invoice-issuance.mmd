---
title: Monthly invoice issuance - processed usage only
config:
  layout: elk
  flowchart:
    wrappingWidth: 440
    nodeSpacing: 35
    rankSpacing: 24
    useMaxWidth: false
---
%% One durable transaction. The account lock serializes worker processing and closing.
%% Numbered boxes are logical activities, not separate transactions.
flowchart TB
    request["<b>1. Validate the closing input</b><br/>POST /customers/{customer_id}/invoices<br/>Input: customer_id and YYYY-MM month"]
    subgraph issue["One atomic publication transaction - no pending usage processing"]
        begin["<b>2. Begin the transaction</b><br/>synchronous_commit = on"]
        lock["<b>3. Lock the customer account</b><br/>customer_billing_state; FOR UPDATE<br/>Include only usage processing committed before this lock"]
        issued{"Invoice already exists for this customer/month?"}
        time["<b>4. Sample the server UTC issue time</b><br/>Truncate to microseconds"]
        completed{"<b>5. Has the whole UTC month ended?</b>"}
        ready{"<b>6. Is closing history valid?</b><br/>First closing: no earlier usage in usage_inbox<br/>Later closing: previous month must be closed<br/>No closed target/later month or earlier unclosed groups"}
        buyer["<b>7. Read buyer details and the next number</b><br/>Tables: customers, customer_billing_state<br/>Fields: name, country, billing_address, next_invoice_number"]
        header["<b>8. Build the invoice header</b><br/>Currency: USD; month: requested UTC month<br/>Number: uppercase customer ID + padded sequence<br/>Reject an exhausted sequence before publication"]
        groups["<b>9. Load the target month's rated groups</b><br/>Table: rated_usage_groups; filter: customer and billing_month<br/>Order: usage_month, metric, price_version_id<br/>Input: units, exact gross ticks, allocated credit ticks"]
        addons["<b>10. Load applicable add-on subscriptions</b><br/>Table: addon_subscriptions; start_month at or before target<br/>Order: addon_name, subscription_id<br/>Use each subscription's stored full monthly price"]
        net["<b>11. Calculate each group's exact net</b><br/>Repeat steps 11-15 for each group; skip when there are none<br/>Formula: gross ticks - previously allocated credit ticks<br/>Reject credit exceeding gross; do not debit credit again"]
        roundGross["<b>12. Round each group's gross to cents</b><br/>Rule: half-up; reject values outside signed 64-bit cents"]
        roundNet["<b>13. Round each group's net to cents</b><br/>Rule: half-up; reject values outside signed 64-bit cents"]
        deduction["<b>14. Derive each group's displayed credit</b><br/>Formula: rounded gross cents - rounded net cents"]
        usageLines["<b>15. Assemble usage lines and audit totals</b><br/>One usage line per group, displaying gross cents<br/>Keep price, metric, original usage month, units and exact ticks<br/>Label earlier usage_month as late usage<br/>Sum exact gross, exact credit and displayed credit deductions"]
        addonLines["<b>16. Append the add-on lines</b><br/>Amount: full stored monthly price in cents<br/>Credit allocated to usage does not reduce add-ons"]
        creditLine["<b>17. Append one aggregate credit line</b><br/>Amount: negative sum of the group credit deductions<br/>Include the line even when its amount is zero"]
        total["<b>18. Calculate and validate the invoice total</b><br/>Formula: sum all usage, add-on and credit lines<br/>Use an arbitrary-precision sum; validate the final result<br/>Required range: nonnegative signed 64-bit cents"]
        encode["<b>19. Serialize the complete immutable snapshot</b><br/>JSON: buyer, number, month, currency, issue time,<br/>lines, total cents and exact audit totals"]
        closed["<b>20. Mark the month closed</b><br/>Table: closed_billing_months"]
        store["<b>21. Store the invoice snapshot</b><br/>Table: invoices; lines are stored in snapshot.lines<br/>One invoice per customer/month and customer sequence"]
        freeze["<b>22. Link and freeze the included groups</b><br/>Table: invoiced_usage_groups<br/>Input: all rated groups for this customer/billing_month"]
        advance["<b>23. Advance the account counters</b><br/>Table: customer_billing_state<br/>Increment next_invoice_number and state_version"]
        commit["<b>24. Commit the publication transaction</b><br/>Closure, snapshot, group freeze and counters publish together<br/>Release the account lock"]
        previous["<b>Read the existing immutable snapshot</b><br/>Table: invoices<br/>Commit without constructing or numbering another invoice"]
    end

    response["<b>25. Return 200 with the committed invoice</b><br/>Retry returns the same snapshot and number"]
    invalid["422 invalid_command<br/>Invalid input or unfinished UTC month"]
    conflict["409 billing_conflict<br/>Missing predecessor, skipped earlier data or incompatible closed history"]
    missing["404 not_found<br/>No customer billing account"]
    failure["503 billing_unavailable when a response is possible<br/>Roll back all uncommitted publication writes<br/>Retry the same customer/month; check ambiguous commits"]
    pending["Pending or quarantined usage stays in usage_inbox<br/>Closing never processes it or debits its credit<br/>Worker later routes it to an eligible open billing month"]

    request --> begin --> lock --> issued
    request -.->|"Invalid"| invalid
    lock -.->|"Missing account: rollback"| missing
    issued -->|"Yes"| previous --> commit
    issued -->|"No"| time --> completed
    completed -->|"No: rollback"| invalid
    completed -->|"Yes"| ready
    ready -->|"No: rollback"| conflict
    ready -->|"Yes"| buyer --> header --> groups --> addons
    addons --> net --> roundGross --> roundNet --> deduction --> usageLines
    usageLines --> addonLines --> creditLine --> total --> encode
    encode --> closed --> store --> freeze --> advance --> commit --> response
    total -.->|"Calculation failure: rollback"| failure
    freeze -.->|"Storage failure: rollback"| failure
    commit -.->|"After account lock release"| pending
    classDef operation fill:#eff6ff,stroke:#2563eb,color:#1e3a8a
    classDef issuance fill:#fffbeb,stroke:#d97706,color:#78350f
    classDef error fill:#fef2f2,stroke:#dc2626,color:#7f1d1d
    classDef success fill:#ecfdf5,stroke:#16a34a,color:#14532d
    class request,begin,lock,time operation
    class buyer,header,groups,addons,net,roundGross,roundNet,deduction,usageLines,addonLines,creditLine,total,encode,closed,store,freeze,advance,commit issuance
    class invalid,conflict,missing,failure error
    class previous,response,pending success
    style issue fill:#fffbeb,stroke:#d97706
