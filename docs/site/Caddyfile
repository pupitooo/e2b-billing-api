{
	auto_https off
	admin off
}

:8080 {
	header -Server
	header Cache-Control "no-cache"

	# The demonstration is a separate static browser client, with no Go handlers.
	handle /demo/runtime.json {
		header Cache-Control "no-store"
		root * /tmp/e2b-demo-runtime
		rewrite * /runtime.json
		file_server
	}

	handle /demo {
		redir /demo/ 308
	}

	handle_path /demo/* {
		root * /demo
		file_server
	}

	# Keep Adminer links on the portal origin, regardless of local port settings.
	handle /database {
		redir /database/ 308
	}

	handle_path /database/* {
		reverse_proxy adminer:8080 {
			header_up X-Forwarded-Prefix /database
		}
	}

	# Scalar's relative assets resolve beneath this trailing slash.
	handle /reference {
		redir /reference/ 308
	}

	handle_path /reference/* {
		reverse_proxy api-docs:8080
	}

	# Scalar browser requests share the portal origin.
	handle_path /api/* {
		reverse_proxy api:8080
	}

	# Forward live-reload requests as well as the rendered guides.
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
