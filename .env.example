E2B_API_PORT=8081
# One portal port: Markdown guides at /, Scalar API reference at /reference/.
E2B_DOCS_PORT=8082
E2B_POSTGRES_PORT=5432
E2B_POSTGRES_PASSWORD=e2b_local_dev

# Positive Go durations, such as 500ms, 10s, or 2m.
E2B_API_STARTUP_TIMEOUT=10s
E2B_API_READ_HEADER_TIMEOUT=5s
E2B_API_READ_TIMEOUT=15s
E2B_API_WRITE_TIMEOUT=35s
E2B_API_IDLE_TIMEOUT=90s
E2B_API_INGESTION_TIMEOUT=10s
E2B_API_ROLLBACK_TIMEOUT=5s
E2B_API_SHUTDOWN_TIMEOUT=45s
# Compose must leave time for HTTP draining and database cleanup.
E2B_API_STOP_GRACE_PERIOD=60s

# Budgets apply to each API process; reserve connections for accounting and administration.
E2B_API_DB_MAX_CONNS=8
E2B_API_DB_MIN_CONNS=2
E2B_API_MAX_IN_FLIGHT_BATCHES=32

# All worker runtime settings are required when running the binary directly.
E2B_WORKER_POLL_INTERVAL=1s
E2B_WORKER_BATCH_TIMEOUT=5s
E2B_WORKER_SHUTDOWN_TIMEOUT=5s
E2B_WORKER_HEARTBEAT_MAX_AGE=15s
E2B_WORKER_HEARTBEAT_FILE=/tmp/billing-worker-heartbeat
E2B_WORKER_STOP_GRACE_PERIOD=10s
